DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
PORT=3001
# Domínios que podem chamar a API (web e admin em dev e produção), separados por vírgula
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# Gere uma chave aleatória forte e mantenha-a somente no ambiente do servidor.
ADMIN_API_KEY="CHANGE_ME"